# GEMINI_API_KEY : Clé API Gemini pour le conseiller IA Seka.
# Obtenez-la gratuitement sur https://aistudio.google.com/app/apikey
# Sans cette clé, l'application fonctionne avec un conseiller intégré (mode local).
GEMINI_API_KEY="VOTRE_CLE_GEMINI_ICI"

# APP_URL : URL de l'application (optionnel en développement local)
APP_URL="http://localhost:3000"
